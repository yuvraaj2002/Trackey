{
  "info": {
    "name": "Trackey",
    "description": "Trackey spend tracking and analytics APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "categoryId", "value": "1" },
    { "key": "spendId", "value": "1" },
    { "key": "cursor", "value": "0" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Database health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/db"
          }
        }
      ]
    },
    {
      "name": "Spend Categories",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/spend-categories"
          }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries\"\n}"
            },
            "url": "{{baseUrl}}/spend-categories"
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/spend-categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Spends",
      "item": [
        {
          "name": "List spends",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/spends?category_id={{categoryId}}&cursor={{cursor}}",
              "host": ["{{baseUrl}}"],
              "path": ["spends"],
              "query": [
                { "key": "category_id", "value": "{{categoryId}}", "description": "Optional filter", "disabled": true },
                { "key": "cursor", "value": "{{cursor}}", "description": "Optional cursor (last id)", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create spend",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Weekly groceries\",\n  \"amount\": \"120.50\",\n  \"category_id\": {{categoryId}}\n}"
            },
            "url": "{{baseUrl}}/spends"
          }
        },
        {
          "name": "Update spend",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Weekly groceries updated\",\n  \"amount\": \"130.00\"\n}"
            },
            "url": "{{baseUrl}}/spends/{{spendId}}"
          }
        },
        {
          "name": "Delete spend",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/spends/{{spendId}}"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get analytics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/analytics?start=2026-11-01T00:00:00Z&end=2026-11-30T23:59:59Z&top_limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["analytics"],
              "query": [
                { "key": "start", "value": "2026-11-01T00:00:00Z" },
                { "key": "end", "value": "2026-11-30T23:59:59Z" },
                { "key": "top_limit", "value": "5", "description": "Optional, default 5" }
              ]
            }
          }
        }
      ]
    }
  ]
}
